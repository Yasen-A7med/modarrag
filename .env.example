# Modarrag (مُدَرَّج) Environment Configuration Template
# Copy this file to .env.local and fill in real values.

# --- Supabase (Required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# --- Supabase Server Admin (Optional; required only for privileged admin scripts/jobs) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- QR Token Signing (Required in production; >= 32 characters) ---
QR_SIGNING_SECRET=replace-with-a-cryptographically-random-secret-at-least-32-chars

# --- App Defaults ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_SCHOOL_SLUG=ali-bin-abi-talib

# --- Upstash Redis Rate Limiting (Optional; falls back to in-memory limiter when unset) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudflare Turnstile Bot Protection (Optional; bypassed with warning when unset) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
